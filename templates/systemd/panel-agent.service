[Unit]
Description=Vpanel Privileged System Daemon (Root Agent)
Documentation=https://github.com/Whyriez/Vpanel
After=network.target
Before=panel-api.service

[Service]
Type=simple
User=root
Group=panel
ExecStart=/usr/local/bin/panel-agent
Restart=always
RestartSec=3s
KillMode=mixed
LimitNOFILE=65535

# Systemd security hardening; measure the score on the target host.
NoNewPrivileges=true
# Host procfs remounts run in panel-proc-hardening.service, not this daemon.
ProtectSystem=strict
# Account tools and PHP/APT need configuration, package databases, caches and logs.
# Node/Python live in /opt; packages write /usr; lifecycle tools need /home and /run.
# These are privileged agent permissions, never API or tenant service permissions.
ReadWritePaths=/etc /home /opt /usr /var /run
# A read-only /home mount would override the writable entry for that same path.
ProtectHome=false
PrivateTmp=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# nginx -t checks listening sockets on privileged HTTP/HTTPS ports too.
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_SETUID CAP_SETGID CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_KILL CAP_SYS_RESOURCE
PrivateDevices=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=false
LockPersonality=true

# Runtime & State directories for agent socket
RuntimeDirectory=panel
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target
